#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

config UAV_IMU
	tristate "\"Imu sensor test!\" uav"
	default n
	---help---
		Enable the \"Imu sensor test!\" uav

if UAV_IMU

config UAV_IMU_PROGNAME
	string "Program name"
	default "imu"
	---help---
		This is the name of the program that will be used when the NSH ELF
		program is installed.

config UAV_IMU_PRIORITY
	int "uav imu task priority"
	default 100

config UAV_IMU_STACKSIZE
	int "Imu stack size"
	default DEFAULT_TASK_STACKSIZE

endif
